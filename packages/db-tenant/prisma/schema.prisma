// Schema "plantilla" — se aplica a la base de datos de CADA tenant (una DB
// distinta por tenant, ver docs/ARQUITECTURA.md). El `output` del generator
// es propio (no el default de @prisma/client) para no chocar con el cliente
// generado por packages/db-control en el mismo node_modules del workspace.
//
// `binaryTargets` explícito (Fase 11): al tener un `output` custom, Next.js/
// Vercel no detecta ni empaqueta solo el motor de consultas para el runtime
// de las funciones serverless (rhel-openssl-3.0.x) como sí hace con la
// ubicación default de @prisma/client (por eso db-control nunca tuvo este
// problema). Sin esto, `createTenant` crea la DB del tenant bien pero
// revienta en el último paso (la verificación con `getTenantPrismaClient`)
// con "could not locate the Query Engine for runtime rhel-openssl-3.0.x" —
// visto en producción real. "native" sigue para que `npm run dev` en
// Windows genere su propio motor sin depender de esto.
generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UsuarioRol {
  TENANT_ADMIN
  SEDE_ADMIN
  VENDEDOR
  CLIENTE
}

enum RifaEstado {
  BORRADOR
  ACTIVA
  CERRADA
  CANCELADA
}

enum BoletoEstado {
  DISPONIBLE
  RESERVADO
  VENDIDO
}

enum VentaEstado {
  PENDIENTE
  PAGADA
  ANULADA
  VENCIDA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  OTRO
  WOMPI
}

// Fase 19A: formato de dígitos del número de boleto — opcional (rifas
// legacy sin formato siguen numerando 1..cantidadBoletos como siempre).
// Con formato, la numeración arranca en 0 (ej. "00" es un boleto válido).
enum RifaFormatoDigitos {
  DOS // 00-99
  TRES // 000-999
  CUATRO // 0000-9999
}

model Sede {
  id        String    @id @default(uuid())
  nombre    String
  usuarios  Usuario[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Usuario {
  id                 String     @id @default(uuid())
  email              String     @unique
  passwordHash       String
  nombre             String?
  rol                UsuarioRol
  sedeId             String?
  sede               Sede?      @relation(fields: [sedeId], references: [id])
  rifasCreadas       Rifa[]     @relation("RifaCreador")
  ventasComoVendedor Venta[]    @relation("VentaVendedor")
  ventasComoCliente  Venta[]    @relation("VentaCliente")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Rifa {
  id                 String              @id @default(uuid())
  nombre             String
  descripcion        String?
  precioBoleto       Decimal             @db.Decimal(12, 2)
  cantidadBoletos    Int
  estado             RifaEstado          @default(BORRADOR)
  fechaSorteo        DateTime?
  boletoGanadorId    String?             @unique
  boletoGanador      Boleto?             @relation("RifaGanador", fields: [boletoGanadorId], references: [id])
  creadoPorId        String
  creadoPor          Usuario             @relation("RifaCreador", fields: [creadoPorId], references: [id])
  boletos            Boleto[]            @relation("RifaBoletos")
  ventas             Venta[]
  formatoDigitos     RifaFormatoDigitos?
  premiosAnticipados PremioAnticipado[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// Fase 19A: premio que se entrega ANTES del sorteo principal, atado a un
// número de boleto puntual de la rifa (no necesariamente vendido todavía).
model PremioAnticipado {
  id          String    @id @default(uuid())
  rifaId      String
  rifa        Rifa      @relation(fields: [rifaId], references: [id])
  nombre      String
  descripcion String?
  numero      Int
  entregado   Boolean   @default(false)
  entregadoAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([rifaId, numero])
}

model Boleto {
  id           String       @id @default(uuid())
  rifaId       String
  rifa         Rifa         @relation("RifaBoletos", fields: [rifaId], references: [id])
  numero       Int
  estado       BoletoEstado @default(DISPONIBLE)
  ventaId      String?
  venta        Venta?       @relation(fields: [ventaId], references: [id])
  rifaGanadora Rifa?        @relation("RifaGanador")
  createdAt    DateTime     @default(now())

  @@unique([rifaId, numero])
}

model Venta {
  id                String      @id @default(uuid())
  rifaId            String
  rifa              Rifa        @relation(fields: [rifaId], references: [id])
  vendedorId        String?
  vendedor          Usuario?    @relation("VentaVendedor", fields: [vendedorId], references: [id])
  clienteId         String?
  cliente           Usuario?    @relation("VentaCliente", fields: [clienteId], references: [id])
  compradorNombre   String?
  compradorTelefono String?
  montoTotal        Decimal     @db.Decimal(12, 2)
  metodoPago        MetodoPago
  estado            VentaEstado @default(PENDIENTE)
  boletos           Boleto[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// Schema "plantilla" — se aplica a la base de datos de CADA tenant (una DB
// distinta por tenant, ver docs/ARQUITECTURA.md). El `output` del generator
// es propio (no el default de @prisma/client) para no chocar con el cliente
// generado por packages/db-control en el mismo node_modules del workspace.
//
// `binaryTargets` explícito (Fase 11): al tener un `output` custom, Next.js/
// Vercel no detecta ni empaqueta solo el motor de consultas para el runtime
// de las funciones serverless (rhel-openssl-3.0.x) como sí hace con la
// ubicación default de @prisma/client (por eso db-control nunca tuvo este
// problema). Sin esto, `createTenant` crea la DB del tenant bien pero
// revienta en el último paso (la verificación con `getTenantPrismaClient`)
// con "could not locate the Query Engine for runtime rhel-openssl-3.0.x" —
// visto en producción real. "native" sigue para que `npm run dev` en
// Windows genere su propio motor sin depender de esto.
generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UsuarioRol {
  TENANT_ADMIN
  SEDE_ADMIN
  VENDEDOR
  CLIENTE
}

enum RifaEstado {
  BORRADOR
  ACTIVA
  CERRADA
  CANCELADA
}

enum BoletoEstado {
  DISPONIBLE
  RESERVADO
  VENDIDO
}

enum VentaEstado {
  PENDIENTE
  PAGADA
  ANULADA
  VENCIDA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  OTRO
  WOMPI
}

// Fase 19A: formato de dígitos del número de boleto — opcional (rifas
// legacy sin formato siguen numerando 1..cantidadBoletos como siempre).
// Con formato, la numeración arranca en 0 (ej. "00" es un boleto válido).
enum RifaFormatoDigitos {
  DOS // 00-99
  TRES // 000-999
  CUATRO // 0000-9999
}

// Fase 19B: cómo llegó un boleto a estar asignado a su dueño actual
// (Sede o Vendedor) — CONSECUTIVO/ALEATORIO/ABONADOS son los 3 modos que
// elige el TENANT_ADMIN al asignar; TRASPASO marca que llegó por un
// traspaso aceptado (no por una asignación original).
enum AsignacionModo {
  CONSECUTIVO
  ALEATORIO
  ABONADOS
  TRASPASO
}

enum TraspasoEstado {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

model Sede {
  id                    String              @id @default(uuid())
  nombre                String
  usuarios              Usuario[]
  boletosAsignados      Boleto[]            @relation("BoletoAsignadoSede")
  traspasosComoPoseedor SolicitudTraspaso[] @relation("TraspasoPoseedorSede")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model Usuario {
  id                        String              @id @default(uuid())
  email                     String              @unique
  passwordHash              String
  nombre                    String?
  rol                       UsuarioRol
  sedeId                    String?
  sede                      Sede?               @relation(fields: [sedeId], references: [id])
  rifasCreadas              Rifa[]              @relation("RifaCreador")
  ventasComoVendedor        Venta[]             @relation("VentaVendedor")
  ventasComoCliente         Venta[]             @relation("VentaCliente")
  boletosAsignados          Boleto[]            @relation("BoletoAsignadoVendedor")
  traspasosSolicitados      SolicitudTraspaso[] @relation("TraspasoSolicitante")
  traspasosComoPoseedor     SolicitudTraspaso[] @relation("TraspasoPoseedorVendedor")
  traspasosResueltos        SolicitudTraspaso[] @relation("TraspasoResueltoPor")
  // Fase 19C: % de comisión propio del vendedor — null = todavía no
  // configurado (liquidar exige que esté seteado, no se asume 0%).
  comisionPct               Decimal?            @db.Decimal(5, 2)
  liquidacionesGeneradas    Liquidacion[]       @relation("LiquidacionGeneradaPor")
  liquidacionesComoVendedor Liquidacion[]       @relation("LiquidacionVendedor")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

model Rifa {
  id                  String              @id @default(uuid())
  nombre              String
  descripcion         String?
  precioBoleto        Decimal             @db.Decimal(12, 2)
  cantidadBoletos     Int
  estado              RifaEstado          @default(BORRADOR)
  fechaSorteo         DateTime?
  boletoGanadorId     String?             @unique
  boletoGanador       Boleto?             @relation("RifaGanador", fields: [boletoGanadorId], references: [id])
  creadoPorId         String
  creadoPor           Usuario             @relation("RifaCreador", fields: [creadoPorId], references: [id])
  boletos             Boleto[]            @relation("RifaBoletos")
  ventas              Venta[]
  formatoDigitos      RifaFormatoDigitos?
  premiosAnticipados  PremioAnticipado[]
  solicitudesTraspaso SolicitudTraspaso[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

// Fase 19A: premio que se entrega ANTES del sorteo principal, atado a un
// número de boleto puntual de la rifa (no necesariamente vendido todavía).
model PremioAnticipado {
  id          String    @id @default(uuid())
  rifaId      String
  rifa        Rifa      @relation(fields: [rifaId], references: [id])
  nombre      String
  descripcion String?
  numero      Int
  entregado   Boolean   @default(false)
  entregadoAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([rifaId, numero])
}

model Boleto {
  id           String       @id @default(uuid())
  rifaId       String
  rifa         Rifa         @relation("RifaBoletos", fields: [rifaId], references: [id])
  numero       Int
  estado       BoletoEstado @default(DISPONIBLE)
  ventaId      String?
  venta        Venta?       @relation(fields: [ventaId], references: [id])
  rifaGanadora Rifa?        @relation("RifaGanador")
  createdAt    DateTime     @default(now())

  // Fase 19B: dueño actual del boleto (mutuamente excluyentes — un boleto
  // asignado a un vendedor no tiene asignadoASedeId, y viceversa; sin
  // ninguno de los dos = libre, vendible por cualquiera, el default de
  // todo lo que ya existía antes de esta fase).
  asignadoASedeId     String?
  asignadoASede       Sede?               @relation("BoletoAsignadoSede", fields: [asignadoASedeId], references: [id])
  asignadoAVendedorId String?
  asignadoAVendedor   Usuario?            @relation("BoletoAsignadoVendedor", fields: [asignadoAVendedorId], references: [id])
  asignacionModo      AsignacionModo?
  abonadoId           String?
  abonado             Abonado?            @relation(fields: [abonadoId], references: [id])
  solicitudesTraspaso SolicitudTraspaso[]

  @@unique([rifaId, numero])
}

// Fase 19B: cliente recurrente que repite el mismo número en cada rifa
// nueva ("modo abonados" de asignación) — identificado por teléfono
// porque los compradores de un vendedor son hoy texto libre (Venta.
// compradorTelefono), sin cuenta de Usuario/CLIENTE detrás.
model Abonado {
  id        String   @id @default(uuid())
  nombre    String
  telefono  String   @unique
  numero    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  boletos   Boleto[]
}

// Fase 19B: pedido de un vendedor/sede para que le traspasen un número que
// tiene otro vendedor u otra sede. `poseedorId`/`poseedorSedeId` son
// mutuamente excluyentes, igual que en Boleto — reflejan quién lo tenía al
// momento de pedirlo.
model SolicitudTraspaso {
  id             String         @id @default(uuid())
  boletoId       String
  boleto         Boleto         @relation(fields: [boletoId], references: [id])
  rifaId         String
  rifa           Rifa           @relation(fields: [rifaId], references: [id])
  numero         Int
  solicitanteId  String
  solicitante    Usuario        @relation("TraspasoSolicitante", fields: [solicitanteId], references: [id])
  poseedorId     String?
  poseedor       Usuario?       @relation("TraspasoPoseedorVendedor", fields: [poseedorId], references: [id])
  poseedorSedeId String?
  poseedorSede   Sede?          @relation("TraspasoPoseedorSede", fields: [poseedorSedeId], references: [id])
  estado         TraspasoEstado @default(PENDIENTE)
  motivoRechazo  String?
  resueltoPorId  String?
  resueltoPor    Usuario?       @relation("TraspasoResueltoPor", fields: [resueltoPorId], references: [id])
  resueltoAt     DateTime?
  createdAt      DateTime       @default(now())
}

model Venta {
  id                String       @id @default(uuid())
  rifaId            String
  rifa              Rifa         @relation(fields: [rifaId], references: [id])
  vendedorId        String?
  vendedor          Usuario?     @relation("VentaVendedor", fields: [vendedorId], references: [id])
  clienteId         String?
  cliente           Usuario?     @relation("VentaCliente", fields: [clienteId], references: [id])
  compradorNombre   String?
  compradorTelefono String?
  montoTotal        Decimal      @db.Decimal(12, 2)
  metodoPago        MetodoPago
  estado            VentaEstado  @default(PENDIENTE)
  boletos           Boleto[]
  // Fase 19C: qué ventas ya quedaron cubiertas por una liquidación de
  // comisión — null = todavía pendiente de liquidar.
  liquidacionId     String?
  liquidacion       Liquidacion? @relation(fields: [liquidacionId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// Fase 19C: registro contable de una liquidación de comisión — inmutable,
// snapshotea el % usado al momento de liquidar (si el admin cambia el % del
// vendedor después, las liquidaciones viejas no se recalculan). El pago en
// sí lo hace el admin por fuera del sistema, igual que ya pasa con ventas
// en efectivo — esto solo registra que ese período quedó liquidado.
model Liquidacion {
  id             String   @id @default(uuid())
  vendedorId     String
  vendedor       Usuario  @relation("LiquidacionVendedor", fields: [vendedorId], references: [id])
  periodoDesde   DateTime
  periodoHasta   DateTime
  comisionPct    Decimal  @db.Decimal(5, 2)
  montoVentas    Decimal  @db.Decimal(12, 2)
  montoComision  Decimal  @db.Decimal(12, 2)
  cantidadVentas Int
  generadaPorId  String
  generadaPor    Usuario  @relation("LiquidacionGeneradaPor", fields: [generadaPorId], references: [id])
  createdAt      DateTime @default(now())
  ventas         Venta[]
}

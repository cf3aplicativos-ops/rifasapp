generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum TenantEstado {
  PROVISIONANDO
  ACTIVO
  SUSPENDIDO
  ERROR
}

model Tenant {
  id                      String       @id @default(cuid())
  slug                    String       @unique
  nombre                  String
  connectionStringCifrado String?
  estado                  TenantEstado @default(PROVISIONANDO)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Fase 12: singleton (una sola fila, sin id fijo hardcodeado — ver
// getPlatformConfig en src/platform-config.ts) para guardar el dominio base
// de la plataforma desde la UI de superadmin. Es solo referencia/instrucción
// hoy — no reconfigura nada en Vercel/DNS por sí mismo.
model PlatformConfig {
  id                 String   @id @default(cuid())
  baseDomain         String?
  // Imagen de fondo del login de admin/vendedores/clientes (Fase 16), pegada
  // como URL o subida a Vercel Blob desde /apariencia de superadmin — global
  // para toda la plataforma, no por tenant. Null = fondo plano de siempre.
  loginBackgroundUrl String?
  updatedAt          DateTime @updatedAt
}
